---
import type { Publication } from '../lib/content';
import { formatDate } from '../lib/content';
interface Props { publication: Publication; inverse?: boolean; }
const { publication, inverse = false } = Astro.props;
---
<div class:list={['article-metadata', { inverse }]}>
  <span>{formatDate(publication.data.publishedDate)}</span>
  <span aria-hidden="true">·</span>
  <span>{publication.data.readingTime} min read</span>
  <span aria-hidden="true">·</span>
  <span>SCM Research Team</span>
</div>
