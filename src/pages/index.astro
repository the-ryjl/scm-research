---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { byNewest, slugify } from '../lib/content';

const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(byNewest);
const featured = publications.find((entry) => entry.data.featured) ?? publications[0];
const recent = publications.filter((entry) => entry.id !== featured.id).slice(0, 6);
const coverage = [
  { title: 'Technology', href: '/pods/#technology', text: 'Specialized coverage across software, fintech and payments, internet, semiconductors, media, and digital infrastructure.', count: publications.filter((p) => p.data.pod === 'Technology').length },
  { title: 'Fixed Income and Credit', href: '/pods/#fixed-income-credit', text: 'Macro and rates strategy alongside investment-grade, high-yield, and distressed credit research.', count: publications.filter((p) => p.data.pod === 'Fixed Income and Credit').length }
];
---
<BaseLayout>
  <Hero />
  <section class="featured-wrap">
    <div class="shell"><FeaturedArticle publication={featured} /></div>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><span class="eyebrow">Latest thinking</span><h2>Recent research</h2></div><a class="text-link" href="/research/">Browse the archive <span aria-hidden="true">→</span></a></div>
    <div class="article-grid">{recent.map((publication, index) => <ArticleCard publication={publication} index={index} />)}</div>
  </section>
  <section class="coverage-section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Investment pods</span><h2>Coverage, by desk</h2></div><div class="section-heading-action"><p>Two focused pods pair clear analyst ownership with room to build teams as coverage grows.</p><a class="text-link light" href="/pods/">How the pods work <span aria-hidden="true">→</span></a></div></div>
      <div class="coverage-grid">{coverage.map((item, index) => <article class="coverage-card"><a href={item.href ?? `/category/${slugify(item.title)}/`}><div><span>0{index + 1} / {String(item.count).padStart(2, '0')} notes</span><h3>{item.title}</h3><p>{item.text}</p></div><b aria-hidden="true">↗</b></a></article>)}</div>
    </div>
  </section>
</BaseLayout>
